@using TowerProcessSheet.Models
@using TowerProcessSheet.Controllers
@{
    ViewData["Title"] = "Manage signatures";
    ViewData["FullWidth"] = true;
    var teamSignatures = ViewBag.TeamSignatures as List<ProcessSheetsController.TeamSignatureRow> ?? new();
}
<div class="page-head no-print">
    <h1>Manage signatures</h1>
    <a class="btn" asp-action="Index">Back</a>
</div>

<div class="flash flash-ok">
    Every converted sheet places these signatures directly inside their labeled boxes (Checked by, Complied by,
    Approved, Written By) — always the right size, always in the right spot, automatically. Checked by and Approved
    always use Eng. Eman Mahmoud's signature; Complied by and Written By always use whoever actually converted
    the sheet. Nothing to position manually.
</div>

<div class="card">
    <b>Team signatures — @teamSignatures.Count</b>
    <div class="hint" style="margin:6px 0 14px">Eman Mahmoud and her team. Remove an active signature, or switch to a different one already saved in that person's own gallery — no need for them to touch their own Profile.</div>
    <div class="team-sig-grid">
        @foreach (var t in teamSignatures)
        {
            <div class="team-sig-card">
                <div class="team-sig-name">@t.FullName</div>
                @if (t.HasActive)
                {
                    <img class="team-sig-thumb" src="@Url.Action("TeamSignatureThumb", new { userId = t.UserId })" alt="signature" />
                    <form asp-action="RemoveActiveSignature" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@t.UserId" />
                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                    </form>
                }
                else
                {
                    <div class="muted" style="margin:10px 0">No active signature.</div>
                }
                @if (t.Gallery.Count > 0)
                {
                    <div class="team-sig-gallery-label">Their saved signatures:</div>
                    @foreach (var g in t.Gallery)
                    {
                        <form asp-action="UseGallerySignature" method="post" class="inline-form" style="display:inline-block;margin:2px">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@t.UserId" />
                            <input type="hidden" name="signatureId" value="@g.Id" />
                            <button type="submit" class="btn btn-sm">Use "@(g.Label ?? ("Signature " + g.Id))"</button>
                        </form>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .team-sig-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .team-sig-card { border: 1px solid var(--line); border-radius: 12px; padding: 14px; text-align: center; background: #fbfcff; }
    .team-sig-name { font-weight: 800; font-size: 13.5px; margin-bottom: 8px; }
    .team-sig-thumb { max-width: 100%; max-height: 60px; margin-bottom: 8px; }
    .team-sig-gallery-label { font-size: 11.5px; color: var(--ink-2); margin: 10px 0 4px; }
</style>
