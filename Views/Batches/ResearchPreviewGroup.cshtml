@{
    ViewData["Title"] = "Preview";
    string token = ViewBag.Token;
    string group = ViewBag.Group;
    var files = ViewBag.Files as List<string> ?? new();
    var overridden = ViewBag.Overridden as HashSet<string> ?? new();
    double normX = ViewBag.NormX, normY = ViewBag.NormY, widthPct = ViewBag.WidthPct, fontScale = ViewBag.FontScale;
    bool anchorRight = ViewBag.AnchorRight, anchorBottom = ViewBag.AnchorBottom;
    string groupLabel = group == "angle" ? "Angle" : group == "plate" ? "Plate" : "Other";
}
<div class="page-head no-print">
    <h1>Preview — @groupLabel (@files.Count)</h1>
    <a class="btn" onclick="window.close(); history.back();">Back to Confirm &amp; send</a>
</div>

<div class="hint">Every drawing below shows the stamp exactly as it will be sent. Click any one to reposition <b>just that drawing</b> — everything else stays on the shared position. After sending, you can also fix any single drawing from the Sent page.</div>

<div class="preview-grid">
    @foreach (var f in files)
    {
        var src = Url.Action("ResearchPreviewFile", new {
            token, group, file = f, normX, normY, anchorRight, anchorBottom, widthPct, fontScale
        });
        var adjustUrl = Url.Action("ResearchAdjustFile", new {
            token, group, file = f, normX, normY, anchorRight, anchorBottom, widthPct, fontScale
        });
        <a class="preview-tile" href="@adjustUrl" title="Click to adjust this drawing's stamp">
            @if (overridden.Contains(f!))
            {
                <span class="preview-tile-badge">✎ Custom</span>
            }
            <img src="@src" alt="@f" loading="lazy" />
        </a>
    }
    @if (files.Count == 0)
    {
        <div class="mb-empty">No drawings in this group.</div>
    }
</div>

<style>
    .preview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; margin-top: 18px; }
    .preview-tile { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 8px;
        box-shadow: var(--shadow-sm); display: block; cursor: pointer; transition: .14s; }
    .preview-tile:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(47,111,237,.15); }
    .preview-tile img { width: 100%; height: auto; display: block; border-radius: 6px; }
    .preview-tile-badge { position: absolute; top: 6px; inset-inline-end: 6px; background: var(--amber); color: #1a1200;
        font-weight: 800; font-size: 10.5px; padding: 3px 9px; border-radius: 999px; z-index: 2; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
</style>
