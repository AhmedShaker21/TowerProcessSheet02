@using Microsoft.AspNetCore.Mvc.Rendering
@using TowerProcessSheet.Models
@{
    ViewData["Title"] = "Split & assign";
    var batch = ViewBag.Batch as Batch;
    int total = ViewBag.Total;
    int unassigned = ViewBag.Unassigned;
    var planners = ViewBag.Planners as List<SelectListItem> ?? new();
}
<div class="page-head no-print">
    <h1>Split &amp; assign — @batch?.Name</h1>
    <a class="btn" asp-action="Details" asp-route-id="@batch?.Id">Cancel</a>
</div>

<div class="hint">This batch has <b>@total</b> drawing@(total == 1 ? "" : "s"), <b>@unassigned</b> not yet assigned to anyone. Say how many go to each planner — sheets stay right here in this batch, you'll keep seeing every one of them and its status on this same page.</div>

<form class="card" asp-action="SplitAssign" asp-route-id="@batch?.Id" method="post" id="splitForm">
    @Html.AntiForgeryToken()
    <div id="sharesBody" class="ops-list"></div>
    <button type="button" class="btn" id="addShare">+ Add planner</button>
    <div class="hint" style="margin-top:10px">Total requested: <b id="totalCount">0</b> of <b>@unassigned</b> unassigned</div>

    <div class="step-actions" style="margin-top:16px">
        <button class="btn btn-primary btn-lg" type="submit">Assign</button>
    </div>
</form>

@section Scripts {
<script>
(function () {
  var planners = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(planners.Select(p => new { value = p.Value, text = p.Text })));
  var sharesBody = document.getElementById('sharesBody');
  var totalCount = document.getElementById('totalCount');

  function renumber() {
    var total = 0;
    sharesBody.querySelectorAll('.op-row').forEach(function (row) {
      total += parseInt(row.querySelector('.share-count').value, 10) || 0;
    });
    totalCount.textContent = total;
  }

  function addShare() {
    var row = document.createElement('div');
    row.className = 'op-row';
    var sel = document.createElement('select');
    sel.className = 'input share-planner'; sel.name = 'plannerIds';
    planners.forEach(function (p) {
      var o = document.createElement('option'); o.value = p.value; o.textContent = p.text; sel.appendChild(o);
    });
    var count = document.createElement('input');
    count.type = 'number'; count.className = 'input share-count'; count.name = 'counts';
    count.min = '1'; count.placeholder = 'Count'; count.style.width = '110px';
    count.addEventListener('input', renumber);
    var rm = document.createElement('button');
    rm.type = 'button'; rm.className = 'btn-icon btn-remove'; rm.textContent = '×';
    rm.addEventListener('click', function () { row.remove(); renumber(); });
    row.appendChild(sel); row.appendChild(count); row.appendChild(rm);
    sharesBody.appendChild(row);
  }
  document.getElementById('addShare').addEventListener('click', addShare);
  addShare(); addShare();
})();
</script>
}
